{
  "name": "trame",
  "version": "0.1.0",
  "description": "Framework TypeScript réactif à base de signaux : composants, templates compilés, asynchrone, plugins.",
  "type": "module",
  "main": "dist/trame.js",
  "module": "dist/trame.js",
  "types": "dist/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/types/index.d.ts",
      "import": "./dist/trame.js"
    },
    "./testing": {
      "types": "./dist/types/testing.d.ts",
      "import": "./dist/testing.js"
    }
  },
  "files": [
    "dist",
    "src"
  ],
  "scripts": {
    "build": "node scripts/build.mjs",
    "typecheck": "tsc -p tsconfig.json && tsc -p tsconfig.cli.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "example": "node scripts/example.mjs",
    "bench": "node scripts/bench.mjs",
    "check:templates": "node scripts/check-templates.mjs examples"
  },
  "devDependencies": {
    "@types/node": "^24.19.0",
    "esbuild": "^0.28.2",
    "jsdom": "^30.1.1",
    "typescript": "^7.0.2",
    "vitest": "^5.0.2"
  },
  "private": true,
  "engines": {
    "node": ">=20"
  },
  "bin": {
    "trame-check": "dist/trame-check.mjs"
  }
}
