{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": [
      "ES2022",
      "DOM",
      "DOM.Iterable"
    ],
    "strict": true,
    "noEmit": true,
    "isolatedModules": true,
    "verbatimModuleSyntax": true,
    "useDefineForClassFields": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "noImplicitOverride": true,
    "types": [],
    "paths": {
      "trame": [
        "./src/index.ts"
      ]
    }
  },
  "include": [
    "src",
    "tests",
    "examples"
  ],
  "exclude": [
    "src/cli",
    "tests/typecheck.test.ts",
    "**/.trame"
  ]
}
